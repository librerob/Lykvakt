{
  "name": "otp-vault",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/check-package.mjs",
    "test": "vitest run --pool=threads --maxWorkers=2",
    "test:browser": "node tests/browser.mjs",
    "lint": "eslint src tests/*.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "node scripts/package.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.59.0",
    "esbuild": "npm:esbuild-wasm@0.28.2"
  }
}
